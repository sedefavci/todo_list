        "initialize": "// Code added here will be run once\n// whenever the node is started.\n\n//glabalde DB adında bir data var mı? varsa adını ver yoksa (|| kısmı) initial bir değer (todo kısmı) ver \nconst DB = global.get(\"DB\") || { //global contextinde DB isimli data\n    todo: [] //todo koleksiyon ismi, [] ise içindeki data (dokümanların bulunduğu yer)\n}\n\n/*\n *TODO DB Şema\n id: NOW\n name: \"\"\n done: \"true| false\n stamp: {\n    createdAt: NOW,\n    ip: IP,\n    user: \"\"\n    email:\"\"} \n **/\n\nglobal.set(\"DB\", DB) //global contectini bu ifadeyle set ettik",
        "finalize": "",
