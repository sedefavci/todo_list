        "fieldType": "msg",
        "format": "html",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html lang=\"tr\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Yapılacaklar Listesi</title>\n    <link rel=\"stylesheet\" href=\"/css/bootstrap.min.css\">\n    <link rel=\"stylesheet\" href=\"/font/bootstrap-icons.min.css\">\n</head>\n\n<body>\n    <div class=\"container mt-5\">\n        <div class=\"row\">\n            <div class=\"col-md-8 offset-md-2\">\n                {{#error}}\n                <div class=\"alert alert-danger\">\n                    <h4>{{message}}</h4>\n                </div>\n                {{/error}}\n                <form action=\"/operation/add\" method=\"GET\">\n                    <div class=\"input-group input-group-lg\">\n                        <input required type=\"text\" name=\"name\" class=\"text-muted form-control {{#error}}border-danger{{/error}}\" placeholder=\"Yoğurt al... Ekmek al...\">\n                        <button class=\"btn btn-outline-secondary\" type=\"reset\">Temizle</button>\n                        <button class=\"btn btn-primary px-5\" type=\"submit\">Ekle</button>\n                    </div>\n                </form>\n                <div>\n                    <div class=\"card mt-2 overflow-hidden\">\n                        <div class=\"card-body p-0\">\n                            <div class=\"table-responsive\">\n                                <table class=\" table table-hover m-0\">\n                                    <thead class=\"table-dark\">\n                                        <tr>\n                                            <th colspan=\"3\">İş</th>\n                                        </tr>\n                                    </thead>\n                                    <tbody>\n                                        {{#payload}}\n                                        <tr valign=\"middle\">\n                                            <td>\n                                                {{#done}}\n                                                <div class=\"text-muted\"><del>{{name}}</del></div>\n                                                {{/done}}\n                                                {{^done}}\n                                                <div>{{name}}</div>\n                                                {{/done}}\n                                                <div class=\"badge bg-secondary\"><small>{{date}} {{time}}</small></div>\n                                            </td>\n                                            <td align=\"right\">\n\n                                                <div class=\"btn-group text-right\">\n                                                    <form method=\"POST\">\n                                                        <input type=\"hidden\" name=\"id\" value=\"{{id}}\"/>\n                                                    {{#done}}\n                                                        <button type=\"submit\" formaction=\"/operation/open\" class=\"btn btn-warning\">Aç</button>\n                                                        {{/done}}\n                                                        {{^done}}\n                                                            <a  data-bs-toggle=\"tooltip\"  data-bs-title=\"Düzenle\" href=\"/edit/{{id}}\" type=\"submit\" class=\"btn btn-info\"><i class=\"bi bi-pencil-fill\"></i></a>\n                                                            <button  data-bs-toggle=\"tooltip\"  data-bs-title=\"Hatırlatıcı\" type=\"submit\" class=\"btn btn-secondary\"><i class=\"bi bi-alarm-fill\"></i></button>\n                                                            <button  data-bs-toggle=\"tooltip\"  data-bs-title=\"Tamamla\" type=\"submit\" formaction=\"/operation/complete\" class=\"btn btn-success\"><i class=\"bi bi-check-lg\"></i></button>\n                                                        {{/done}}\n                                                            <button  data-bs-toggle=\"tooltip\"  data-bs-title=\"Sil\" type=\"submit\" formaction=\"/operation/trash\" class=\"btn btn-danger\"><i class=\"bi bi-trash2\"></i></button>\n                                                    </form>\n                                                </div>\n                                            </td>\n                                        </tr>\n                                        {{/payload}}\n                                        {{^payload}}\n                                        <tr>\n                                            <td colspan=\"2\" class=\"text-muted text-center\">Henüz hiç giriş yapılmadı...\n                                            </td>\n                                            <td align=\"right\">\n                                                <div class=\"btn-group\">\n                                                </div>\n                                            </td>\n                                        </tr>\n                                        {{/payload}}\n                                    </tbody>\n                                </table>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <script src=\"/js/bootstrap.bundle.min.js\"></script>\n    <script>\n        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle=\"tooltip\"]')\n        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))\n    </script>\n</body>\n\n</html>",
